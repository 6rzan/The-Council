# The Council — example environment configuration.
# Copy to ../.env and fill in the key(s) you want. NEVER commit a real .env
# (it is gitignored). See specs/002-multi-provider-ui/quickstart.md.

# --- Default provider (Google Gemini) ---------------------------------------
# Free Google AI Studio API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Use the AI Studio (Generative Language) backend, NOT Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Multi-provider (feature 002) — ALL OPTIONAL ----------------------------
# Precedence for the active model:  UI choice  >  env below  >  built-in Gemini.
# A key entered in the Settings panel wins for the running process only and is
# never written here or to disk.

# Pick the provider used when no UI choice is made.
# One of: google | openai | anthropic | opencode | custom
COUNCIL_PROVIDER=

# Optional model override; each provider falls back to its own default.
COUNCIL_MODEL=

# Custom OpenAI-compatible endpoints only (e.g. a local runtime):
COUNCIL_BASE_URL=

# Per-provider API keys (only the one matching COUNCIL_PROVIDER is read):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
# Key for the "custom" OpenAI-compatible provider:
COUNCIL_API_KEY=
